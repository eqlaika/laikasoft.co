---
interface Props {
  title: string;
  description?: string;
  showNav?: boolean;
  directionContract?: string;
}

const {
  title,
  description = "Software utilities for EverQuest",
  showNav = true,
  directionContract,
} = Astro.props;

const path = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    {directionContract && <Fragment set:html={`<!--\n${directionContract}\n-->`} />}
    {showNav && (
      <nav aria-label="Main navigation">
        <a href="/" class="logo" aria-current={path === "/" ? "page" : undefined}>
          <img src="/favicon.png" alt="" class="logo-icon" />Laikasoft
        </a>
        <a href="/stonemite" class="nav-link" aria-current={path === "/stonemite" ? "page" : undefined}>
          <img src="/stonemite-small.png" alt="" class="nav-icon" />Stonemite
        </a>
        <a href="/support" class="nav-link" aria-current={path === "/support" ? "page" : undefined}>Support</a>
      </nav>
    )}
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} Laikasoft &middot; <a href="/support">Support</a></p>
    </footer>
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --bg: #0a0a12;
    --surface: #12121e;
    --border: #1e1e30;
    --text: #c8c8d4;
    --text-muted: #85859a;
    --accent: #7b8cde;
    --accent-dim: #4a5599;
    --font-mono: "SF Mono", "Cascadia Code", "Fira Code", monospace;
    --font-sans: -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
    --max-width: 640px;
  }

  html {
    background: var(--bg);
    color: var(--text);
    color-scheme: dark;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.6;
  }

  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  ::selection {
    background: var(--accent-dim);
    color: #fff;
  }

  a {
    color: var(--accent);
    text-decoration: none;
    text-underline-offset: 0.18em;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible {
    border-radius: 2px;
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
</style>

<style>
  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 1.5rem;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
  }

  .logo {
    margin-right: auto;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .logo-icon {
    width: 20px;
    height: 20px;
  }

  .logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .nav-icon {
    width: 16px;
    height: 16px;
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: var(--accent);
    text-decoration: none;
  }

  main {
    flex: 1;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  footer {
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }

  footer p {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
</style>
